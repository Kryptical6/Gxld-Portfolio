# Copy this file to ".env" and fill in your Supabase project values.
# Both are safe to expose in a frontend build (the anon key is public by design;
# Row Level Security in the database is what protects your data).
#
# Until these are set, the site runs in offline fallback mode (tickets are saved
# only in each visitor's own browser via localStorage).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
